PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Local Postgres started by "npm run db:start" (or "npm run dev" at the repo root).
# Any reachable Postgres works too, e.g. a Neon URL with ?sslmode=require (then skip db:start).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/northwind

# JWT auth: use a long random string (at least 32 characters)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Admin account created by the seed script
SEED_ADMIN_EMAIL=admin@northwind.test
SEED_ADMIN_PASSWORD=change_me

# Optional integrations: endpoints that need them return 503 until set
SENTRY_DSN=
STREAM_API_KEY=
STREAM_API_SECRET=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_CHECKOUT_PRODUCT_ID=
